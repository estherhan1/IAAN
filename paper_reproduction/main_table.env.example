# Copy to paper_reproduction/main_table.env, set paths and original runner commands.
# All default hyperparameters come from the published SLT 2026 Table II:
# af3: K=50 gain=16 | qwen: K=50 gain=12 | kimi: K=200 gain=12
#
# export IAAN_VOXPARADOX_JSON=/your/path/voxparadox_full.json
# export IAAN_AUDIO_BASE=/your/path/voxparadox/audio
#
# Original *_perq_official.py scripts are NOT in this GitHub repository.
# Commands are invoked through 'bash -lc' with these environment variables:
#   IAAN_MODEL, IAAN_K, IAAN_GAIN, IAAN_DATA_PATH (filtered task JSON),
#   IAAN_AUDIO_BASE, IAAN_OUTPUT_DIR, IAAN_MODEL_OUTPUT_DIR, IAAN_TASKS.
# Each runner must produce baseline_report.json and iaan_report.json
# under IAAN_MODEL_OUTPUT_DIR, using the original official data/eval.py format.
# Pass "--ks $IAAN_K --alphas $IAAN_GAIN" (or equivalent) to your runners.
# Do NOT use letter-logit Steer-CD collectors as these runners.
#
# export IAAN_AF3_CMD='python /path/to/af3_perq_official.py ...'
# export IAAN_QWEN_CMD='python /path/to/omni_perq_official.py ...'
# export IAAN_KIMI_CMD='python /path/to/kimi_perq_official.py ...'
