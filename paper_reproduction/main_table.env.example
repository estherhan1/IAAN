# Optional environment: point each model at its own compatible Python environment.
# These interpreters should have torch, the relevant upstream model package,
# numpy, librosa, soundfile, tqdm and GPU/CUDA support installed.
#
# export IAAN_AF3_PYTHON=/path/to/af3-env/bin/python
# export IAAN_QWEN_PYTHON=/path/to/qwen-env/bin/python
# export IAAN_KIMI_PYTHON=/path/to/kimi-env/bin/python
#
# This file is only an example; it is not automatically read by the launcher.
# Source it in your own shell or put these exports in your shell configuration.
# See README.md for --data, --audio-base, --model, --tasks, --k, and --gain.
